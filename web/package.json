{
    "name": "starryhoot",
    "version": "0.0.1",
    "description": "starryhoot",
    "author": "@rustytsuki",
    "license": "BSD-3-CLAUSE",
    "homepage": "https://github.com/rustytsuki/starryhoot/",
    "type": "module",
    "scripts": {
        "shadcn": "shadcn",
        "web:dev": "cross-env VITE_MODE=web npm run server",
        "web:build": "cross-env NODE_ENV=production VITE_MODE=web vite build --mode web",
        "web:publish": "cross-env NODE_ENV=production VITE_MODE=web vite build --mode web_publish",
        "electron:dev": "cross-env VITE_MODE=electron npm run server",
        "electron:build": "cross-env NODE_ENV=production VITE_MODE=electron vite build --mode electron",
        "electron:publish": "cross-env NODE_ENV=production VITE_MODE=electron vite build --mode electron_publish",
        "www:dev": "cross-env VITE_MODE=www npm run server",
        "www:build": "cross-env NODE_ENV=production VITE_MODE=www vite build --mode www",
        "www:publish": "cross-env NODE_ENV=production VITE_MODE=www vite build --mode www_publish",
        "server": "cross-env PORT=65432 node ./src/server/index.mjs",
        "server:dist": "http-server dist/client"
    },
    "devDependencies": {
        "@fluentui/react-components": "^9.60.0",
        "@fluentui/react-file-type-icons": "^8.12.8",
        "@fluentui/react-icons": "^2.0.274",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "autoprefixer": "^10.4.21",
        "bootstrap": "^5.3.3",
        "bootstrap-icons": "^1.11.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "command-line-args": "^5.2.1",
        "compression": "^1.7.4",
        "cross-env": "^7.0.3",
        "express": "^4.18.2",
        "http-server": "^14.1.1",
        "lucide-react": "^0.525.0",
        "msgpackr": "^1.10.1",
        "postcss": "^8.5.6",
        "prop-types": "15.8.1",
        "react": "^18.2.0",
        "react-bootstrap": "^2.10.9",
        "react-dom": "^18.2.0",
        "sass": "^1.70.0",
        "scss": "^0.2.4",
        "shadcn": "^2.3.0",
        "sirv": "^2.0.4",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^3.4.17",
        "tailwindcss-animate": "^1.0.7",
        "tw-animate-css": "^1.3.6",
        "typescript": "^5.8.3",
        "ua-parser-js": "^2.0.3",
        "use-async-effect": "^2.2.7",
        "vike": "^0.4.236",
        "vite": "^6.3.5",
        "vite-plugin-cjs-interop": "^2.2.0",
        "vite-plugin-conditional-compiler": "^0.3.1"
    },
    "dependencies": {
        "@radix-ui/react-alert-dialog": "^1.1.14",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-radio-group": "^1.3.7",
        "@radix-ui/react-slot": "^1.2.3"
    }
}
