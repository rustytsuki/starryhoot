{
    "name": "deploy",
    "type": "module",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "author": "@rustytsuki",
    "license": "BSD-3-CLAUSE",
    "scripts": {
        "fetch_kernel": "node index.js --fetch",
        "win:build": "node index.js -t x86_64-pc-windows-msvc,aarch64-pc-windows-msvc",
        "win:publish": "node index.js -t x86_64-pc-windows-msvc,aarch64-pc-windows-msvc -p",
        "linux:build:rpm": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg rpm",
        "linux:publish:rpm": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg rpm -p",
        "linux:build:deb": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg deb",
        "linux:publish:deb": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg deb -p",
        "linux:build:tar": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg tar.gz",
        "linux:publish:tar": "node index.js -t x86_64-unknown-linux-gnu,aarch64-unknown-linux-gnu --pkg tar.gz -p",
        "mac:build": "node index.js -t x86_64-apple-darwin,aarch64-apple-darwin",
        "mac:publish": "node index.js -t x86_64-apple-darwin,aarch64-apple-darwin -p",
        "site:build:": "node index.js -s -t wasm32-unknown-emscripten",
        "site:publish": "node index.js -s -t wasm32-unknown-emscripten -p"
        
    },
    "devDependencies": {
        "adm-zip": "^0.5.16",
        "command-line-args": "^5.2.1",
        "follow-redirects": "^1.15.9",
        "fs-extra": "^11.3.0",
        "octokit": "^4.1.3",
        "tar": "^7.4.3"
    }
}
