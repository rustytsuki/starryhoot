{
    "name": "starryhoot",
    "version": "1.0.0",
    "description": "StarryHoot Gui",
    "author": "@rustytsuki",
    "license": "BSD-3-CLAUSE",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development electron-vite dev",
        "prod": "npm run build && cross-env electron .",
        "build": "cross-env electron-vite build && node src/utils.mjs --postbuild",
        "pack:dir": "npm run build && electron-builder --dir --config electron-builder.config.js",
        "pack:win": "npm run build && electron-builder --win --config electron-builder.config.js",
        "pack:mac": "npm run build && electron-builder --mac --config electron-builder.config.js"
    },
    "devDependencies": {
        "command-line-args": "^5.2.1",
        "cross-env": "^7.0.3",
        "electron": "^22.3.27",
        "electron-builder": "^24.13.3",
        "electron-vite": "^2.1.0",
        "fs-extra": "^11.2.0",
        "vite": "^5.1.6"
    }
}
